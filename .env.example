APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

RING_MASTER_WORKSPACES=
RING_MASTER_SCAN_STALE_AFTER=3
RING_MASTER_LEASE_SECONDS=900
RING_MASTER_BUILDING_STALL_MINUTES=60
RING_MASTER_CLAUDE_BIN=claude
# Folders added to PATH for gh, git and claude when missing (a web server often lacks the shell's PATH)
RING_MASTER_PATH=/opt/homebrew/bin:/usr/local/bin
RING_MASTER_RUNNER_CONCURRENCY=1
RING_MASTER_RUNNER_MODEL=
RING_MASTER_RUNNER_MAX_BUDGET_USD=
RING_MASTER_RUNNER_MAX_ATTEMPTS=2
RING_MASTER_RUNNER_TICK_SECONDS=5
# no new session while the load average per CPU is above this (0: no cap)
RING_MASTER_RUNNER_MAX_LOAD=4
# minutes nothing new starts after a run hits a usage limit
RING_MASTER_RUNNER_LIMIT_BACKOFF=15

# times failing PR checks send a job back on their own (0: always ask)
RING_MASTER_CI_AUTO_FIX=2

# local cleanup of merged worktrees and branches; GitHub changes wait in the Inbox
RING_MASTER_JANITOR=true
RING_MASTER_JANITOR_EVERY=60
RING_MASTER_JANITOR_PULL=true
RING_MASTER_DEPENDABOT=true
RING_MASTER_JANITOR_SKIP=

# portfolio planner: days between scheduled runs (empty: only on Plan now)
RING_MASTER_PLANNER_EVERY_DAYS=
RING_MASTER_PLANNER_MAX=5

# night shift: a window with its own budget; the briefing is made at BRIEFING_AT
RING_MASTER_NIGHT_SHIFT=true
RING_MASTER_NIGHT_START=22:00
RING_MASTER_NIGHT_END=07:00
RING_MASTER_NIGHT_BUDGET_USD=50
RING_MASTER_NIGHT_CONCURRENCY=
RING_MASTER_BRIEFING_AT=07:30

# how alike (0-1) a past question must be to suggest its answer
RING_MASTER_PRECEDENT_SIMILARITY=0.5

# GitHub signals for the planner: issues, flaky checks, stale Dependabot PRs
RING_MASTER_SIGNALS=true

# factory analyst and replay evaluations
RING_MASTER_IMPROVE_EVERY_DAYS=
RING_MASTER_IMPROVE_MAX=3
RING_MASTER_REPLAY_SPECS=3
RING_MASTER_REPLAY_BUDGET_USD=20

# notification buttons: single-use signed links to RING_MASTER_URL (keep it private: Tailscale, home network)
RING_MASTER_PHONE_ACTIONS=true
RING_MASTER_PHONE_TTL_HOURS=24

# desktop, mail, webhook, ntfy (comma-separated)
RING_MASTER_NOTIFY=
RING_MASTER_NOTIFY_MAIL=
RING_MASTER_NOTIFY_WEBHOOK=
RING_MASTER_NOTIFY_NTFY=
RING_MASTER_NOTIFY_NTFY_TOKEN=
RING_MASTER_URL=http://127.0.0.1:8000
